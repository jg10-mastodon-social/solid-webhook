@prefix : <https://pod.example.com/settings/webhooks.ttl#> .

# Subscribe to inbox for modifications
:webhook1 a :WebHook;
  :topic <https://jg10.solidcommunity.net/inbox/>;
  :handler :InboxModified .

# Subscribe to outbox for new activities
:webhook2 a :WebHook;
  :topic <https://jg10.solidcommunity.net/outbox/>;
  :handler :OutboxModified;
  :actor <https://jg10.solidcommunity.net/actor/#me> .

# Commit changes to a git repository when COMMIT_EDITMSG changes
:commitWebhook a :WebHook;
  :topic <https://pod.example.com/.git/COMMIT_EDITMSG>;
  :handler :CommitHandler;
  :gitDir "/path/to/local/repo" .

# Index markdown pages under a wiki container.
# :maxDepth controls how many container levels are watched:
#   0 = root pages only
#   1 = root plus immediate subfolders (default)
#   2 = root plus two levels of subfolders, and so on
:wikiWebhook a :WebHook;
  :topic <https://pod.example.com/notes/wiki/>;
  :handler :WikiIndexer;
  :indexUrl <https://pod.example.com/notes/wiki/index.ttl>;
  :maxDepth 1 .